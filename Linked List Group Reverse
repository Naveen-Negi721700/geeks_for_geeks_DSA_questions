class Solution {
  public:
    Node* reverseKGroup(Node* head, int k) {
        if (!head) return nullptr;

       
        Node* temp = head;
        int count = 0;
        while (temp && count < k) {
            temp = temp->next;
            count++;
        }
        if (count < k) return head; 

        Node* prev = nullptr;
        Node* curr = head;
        Node* next = nullptr;
        count = 0;
        while (curr && count < k) {
            next = curr->next;
            curr->next = prev;
            prev = curr;
            curr = next;
            count++;
        }

        
        if (next) {
            head->next = reverseKGroup(next, k);
        }

      
        return prev;
    }
};