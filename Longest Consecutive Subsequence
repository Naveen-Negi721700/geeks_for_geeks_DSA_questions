class Solution {
  public:

    // Function to return length of longest subsequence of consecutive integers.
    int longestConsecutive(vector<int>& arr) {
        // Your code here
        int n=arr.size();
        int maxlen=0;
        set<int>s(arr.begin(),arr.end());
        for(int i:s)
        {
            if(s.find(i-1)==s.end())
            {
                int currnum=i;
                int currlen=1;
                while(s.find(currnum+1)!=s.end())
                {
                    currnum+=1;
                    currlen+=1;
                }
                
                maxlen=max(maxlen,currlen);
            }
        }
        return maxlen;
    }
};
