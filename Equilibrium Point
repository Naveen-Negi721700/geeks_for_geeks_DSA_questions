class Solution {
  public:
    int findEquilibrium(vector<int> &arr) {
        int totalSum = 0;
        
       
        for(int i = 0; i < arr.size(); i++) {
            totalSum += arr[i];
        }
        
        int leftSum = 0;
        
       
        for(int i = 0; i < arr.size(); i++) {
            totalSum -= arr[i];  
            
            if(leftSum == totalSum) {
                return i;  
            }
            
            leftSum += arr[i];
        }
        
        return -1; 
    }
};