class Solution {
  public:
    long subarrayXor(vector<int> &arr, int k) {
        unordered_map<int, int> mp;
        int prefixXor = 0;
        long count = 0;
        
        mp[0] = 1;   // Important: for subarrays starting from index 0
        
        for(int i = 0; i < arr.size(); i++) {
            prefixXor ^= arr[i];
            
            if(mp.find(prefixXor ^ k) != mp.end()) {
                count += mp[prefixXor ^ k];
            }
            
            mp[prefixXor]++;
        }
        
        return count;
    }
};
