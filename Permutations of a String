class Solution {
  public:
  
    void solve(string &s, int index, vector<string> &ans){
        // base case
        if(index == s.size()){
            ans.push_back(s);
            return;
        }
        
        for(int i = index; i < s.size(); i++){
            swap(s[index], s[i]);
            solve(s, index + 1, ans);
            swap(s[index], s[i]); // backtrack
        }
    }
  
    vector<string> findPermutation(string &s) {
        vector<string> ans;
        solve(s, 0, ans);
        sort(ans.begin(), ans.end());
        return ans;
    }
};