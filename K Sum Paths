class Solution {
  public:
    
    void solve(Node* root, int k, long long currSum, int &count, unordered_map<long long, int> &mp) {
        if (!root) return;
        
        currSum += root->data;
        
        // Check if there exists a prefix sum to form k
        if (mp.find(currSum - k) != mp.end()) {
            count += mp[currSum - k];
        }
        
        // Store current sum
        mp[currSum]++;
        
        // Recur for left and right
        solve(root->left, k, currSum, count, mp);
        solve(root->right, k, currSum, count, mp);
        
        // Backtrack
        mp[currSum]--;
    }
    
    int countAllPaths(Node *root, int k) {
        unordered_map<long long, int> mp;
        mp[0] = 1; // Important base case
        
        int count = 0;
        solve(root, k, 0, count, mp);
        
        return count;
    }
};
