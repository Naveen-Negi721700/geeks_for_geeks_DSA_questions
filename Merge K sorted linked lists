class Solution {
  public:
    struct compare {
        bool operator()(Node* a, Node* b) {
            return a->data > b->data; // min heap
        }
    };

    Node* mergeKLists(vector<Node*>& arr) {
        priority_queue<Node*, vector<Node*>, compare> pq;

        // Step 1: push all head nodes
        for (int i = 0; i < arr.size(); i++) {
            if (arr[i] != NULL) {
                pq.push(arr[i]);
            }
        }

        // Step 2: dummy node
        Node* dummy = new Node(0);
        Node* tail = dummy;

        // Step 3: process heap
        while (!pq.empty()) {
            Node* temp = pq.top();
            pq.pop();

            tail->next = temp;
            tail = temp;

            if (temp->next != NULL) {
                pq.push(temp->next);
            }
        }

        return dummy->next;
    }
};