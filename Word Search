class Solution {
  public:
    
    bool dfs(vector<vector<char>> &mat, string &word, int i, int j, int k) {
      
        if (k == word.size()) return true;
        
        int n = mat.size();
        int m = mat[0].size();
        
       
        if (i < 0 || j < 0 || i >= n || j >= m || mat[i][j] != word[k])
            return false;
        
    
        char temp = mat[i][j];
        mat[i][j] = '#';
        
       
        bool found = dfs(mat, word, i+1, j, k+1) ||
                     dfs(mat, word, i-1, j, k+1) ||
                     dfs(mat, word, i, j+1, k+1) ||
                     dfs(mat, word, i, j-1, k+1);
        
        
        mat[i][j] = temp;
        
        return found;
    }
    
    bool isWordExist(vector<vector<char>> &mat, string &word) {
        int n = mat.size();
        int m = mat[0].size();
        
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if (dfs(mat, word, i, j, 0))
                    return true;
            }
        }
        
        return false;
    }
};