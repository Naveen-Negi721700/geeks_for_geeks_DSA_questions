class Solution {
public:

    bool isSafe(int row, int col, vector<int> &board) {
        for(int i = 0; i < row; i++) {
            int prevCol = board[i];

            // same column
            if(prevCol == col)
                return false;

            // diagonal check
            if(abs(prevCol - col) == abs(i - row))
                return false;
        }
        return true;
    }

    void solve(int row, int n, vector<int> &board, vector<vector<int>> &ans) {
        if(row == n) {
            vector<int> temp;
            for(int i = 0; i < n; i++) {
                temp.push_back(board[i] + 1);
            }
            ans.push_back(temp);
            return;
        }

        for(int col = 0; col < n; col++) {
            if(isSafe(row, col, board)) {
                board[row] = col;
                solve(row + 1, n, board, ans);
            }
        }
    }

    vector<vector<int>> nQueen(int n) {
        vector<vector<int>> ans;
        vector<int> board(n);

        solve(0, n, board, ans);

        return ans;
    }
};